generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DonorType {
  INDIVIDUAL
  CORPORATE
  COMMUNITY
  FOUNDATION
  INSTITUTION
  PARTNER
  OTHER
}

enum FinanceLedgerType {
  INCOME
  EXPENSE
  REFUND
  FEE
  ADJUSTMENT
}

enum FinanceLedgerStatus {
  POSTED
  VOIDED
}

enum DonorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  FINANCE
  FUNDRAISING
  PROGRAM
  DONOR
  SELLER
  PARTNER
  STAFF
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

enum BeneficiaryType {
  INDIVIDUAL
  FAMILY
  COMMUNITY
  INSTITUTION
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum QurbanAnimalType {
  GOAT
  SHEEP
  COW
}

enum QurbanPackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
  COMPLETED
}

enum QurbanOrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_PROCESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum QurbanSavingStatus {
  ACTIVE
  ON_TRACK
  COMPLETED
  QURBAN_EXECUTED
  OVERDUE
  PAUSED
  CANCELLED
  REFUNDED
}

enum QurbanContributionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum QurbanAnimalStatus {
  REGISTERED
  VERIFIED
  SLAUGHTERED
  PROCESSED
  DISTRIBUTED
  CANCELLED
}

enum QurbanDocumentationType {
  BEFORE_SLAUGHTER
  SLAUGHTER
  AFTER_SLAUGHTER
  DISTRIBUTION
  OTHER
}

enum QurbanDistributionStatus {
  DRAFT
  READY
  DISTRIBUTED
  CANCELLED
}

enum QurbanSavingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  programs        Program[]
  campaigns       Campaign[]
  campaignUpdates CampaignUpdate[]
  beneficiaries   Beneficiary[]
  donorProfile    DonorProfile?

  qurbanPackages       QurbanPackage[]
qurbanAnimals        QurbanAnimal[]
qurbanDocumentations QurbanDocumentation[]
qurbanDistributions  QurbanDistribution[]

  @@index([email])
  @@index([phone])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([code])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

model FinanceLedger {
  id                   String              @id @default(uuid())

  transactionDate      DateTime            @default(now())

  type                 FinanceLedgerType
  status               FinanceLedgerStatus @default(POSTED)

  reference            String              @unique

  donationId           String?
  paymentTransactionId String?
  receiptId            String?
  campaignId           String?

  description          String?

  amount               Decimal             @db.Decimal(18, 2)
  currency             String              @default("IDR")

  metadata             Json?

  createdById           String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  donation             Donation?           @relation(fields: [donationId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  receipt              Receipt?            @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  campaign             Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([transactionDate])
  @@index([type])
  @@index([status])
  @@index([donationId])
  @@index([paymentTransactionId])
  @@index([campaignId])
}

/*
|--------------------------------------------------------------------------
| PROGRAM
|--------------------------------------------------------------------------
*/

model Program {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  status      ProgramStatus @default(ACTIVE)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  campaigns Campaign[]

  @@index([status])
  @@index([createdById])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN CATEGORY
|--------------------------------------------------------------------------
*/

model CampaignCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([isActive])
}

/*
|--------------------------------------------------------------------------
| BENEFICIARY
|--------------------------------------------------------------------------
*/

model Beneficiary {
  id          String          @id @default(uuid())
  name        String
  type        BeneficiaryType
  description String?
  location    String?
  isActive    Boolean         @default(true)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  campaigns CampaignBeneficiary[]
  qurbanDistributions QurbanDistributionBeneficiary[]

  @@index([type])
  @@index([isActive])
  @@index([createdById])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN
|--------------------------------------------------------------------------
*/

model Campaign {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  shortDescription String?
  description      String?

  targetAmount    Decimal @db.Decimal(18, 2)
  collectedAmount Decimal @default(0) @db.Decimal(18, 2)

  currency String @default("IDR")

  startDate DateTime?
  endDate   DateTime?

  status CampaignStatus @default(DRAFT)

  programId  String
  categoryId String
  createdById String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  program   Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  category  CampaignCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  images        CampaignImage[]
  updates       CampaignUpdate[]
  beneficiaries CampaignBeneficiary[]
  donations     Donation[]
  impacts       CampaignImpact[]
  financeLedgers FinanceLedger[]

  @@index([status])
  @@index([programId])
  @@index([categoryId])
  @@index([createdById])
  @@index([startDate])
  @@index([endDate])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN IMAGE
|--------------------------------------------------------------------------
*/

model CampaignImage {
  id         String  @id @default(uuid())
  campaignId String

  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sortOrder])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN UPDATE
|--------------------------------------------------------------------------
*/

model CampaignUpdate {
  id         String @id @default(uuid())
  campaignId String
  createdById String

  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([createdById])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN BENEFICIARY
|--------------------------------------------------------------------------
*/

model CampaignBeneficiary {
  campaignId    String
  beneficiaryId String

  createdAt DateTime @default(now())

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@id([campaignId, beneficiaryId])
  @@index([beneficiaryId])
}

/*
|--------------------------------------------------------------------------
| DONOR PROFILE
|--------------------------------------------------------------------------
*/

model DonorProfile {
  id        String  @id @default(uuid())
  userId    String? @unique

  fullName  String
  email     String?
  phone     String?

  address   String?
  city      String?
  country   String?

  donorType   DonorType   @default(INDIVIDUAL)
  status      DonorStatus @default(ACTIVE)

  isAnonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  donations Donation[]
  qurbanSavingPlans QurbanSavingPlan[]
  qurbanOrders      QurbanOrder[]

  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@index([donorType])
  @@index([status])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| DONATION
|--------------------------------------------------------------------------
*/

model Donation {
  id         String  @id @default(uuid())
  donorId    String?
  campaignId String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  donorName  String
  donorEmail String?
  donorPhone String?
  message    String?

  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt    DateTime?

  donorProfile DonorProfile? @relation(fields: [donorId], references: [id], onDelete: SetNull)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  payments PaymentTransaction[]
  impacts  DonationImpact[]
  receipts Receipt?
  financeLedgers FinanceLedger[]

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([donorEmail])
  @@index([donorPhone])
}
/*
|--------------------------------------------------------------------------
| PAYMENT TRANSACTION
|--------------------------------------------------------------------------
*/

model PaymentTransaction {
  id         String @id @default(uuid())
  donationId String

  transactionReference String @unique
  provider             String
  paymentMethod        String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  status PaymentStatus @default(INITIATED)

  providerTransactionId String?
  paidAt                DateTime?
  expiredAt             DateTime?
  rawResponse           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)
  financeLedgers FinanceLedger[]

  @@index([donationId])
  @@index([provider])
  @@index([status])
  @@index([providerTransactionId])
  @@index([createdAt])
}
/*
|--------------------------------------------------------------------------
| QURBAN PAYMENT TRANSACTION
|--------------------------------------------------------------------------
| Payment transaction khusus untuk Qurban.
| Dipisahkan dari PaymentTransaction Donation agar
| payment flow Donation tetap backward-compatible.
|--------------------------------------------------------------------------
*/

model QurbanPaymentTransaction {
  id String @id @default(uuid())

  qurbanSavingContributionId String?
  qurbanOrderId              String?

  transactionReference String @unique

  provider      String
  paymentMethod String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  status PaymentStatus @default(INITIATED)

  providerTransactionId String?
  paidAt                DateTime?
  expiredAt             DateTime?

  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qurbanSavingContribution QurbanSavingContribution?
    @relation(
      fields: [qurbanSavingContributionId],
      references: [id],
      onDelete: Restrict
    )

  qurbanOrder QurbanOrder?
    @relation(
      fields: [qurbanOrderId],
      references: [id],
      onDelete: Restrict
    )

  financeLedgers FinanceLedger[]

  @@index([qurbanSavingContributionId])
  @@index([qurbanOrderId])
  @@index([provider])
  @@index([status])
  @@index([providerTransactionId])
  @@index([createdAt])
}
/*
|--------------------------------------------------------------------------
| CAMPAIGN IMPACT
|--------------------------------------------------------------------------
*/

model CampaignImpact {
  id         String @id @default(uuid())
  campaignId String

  name          String
  description   String?
  unit          String
  amountPerUnit Decimal @db.Decimal(18, 2)

  targetQuantity Decimal?
  displayOrder   Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donations DonationImpact[]

  @@index([campaignId])
  @@index([campaignId, isActive])
  @@index([displayOrder])
}

/*
|--------------------------------------------------------------------------
| DONATION IMPACT
|--------------------------------------------------------------------------
*/

model DonationImpact {
  id               String @id @default(uuid())
  donationId       String
  campaignImpactId String

  quantity        Decimal @db.Decimal(18, 2)
  amountAllocated Decimal @db.Decimal(18, 2)
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation       Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaignImpact CampaignImpact @relation(fields: [campaignImpactId], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([campaignImpactId])
}
/*
|--------------------------------------------------------------------------
| RECEIPT / KUITANSI
|--------------------------------------------------------------------------
*/

model Receipt {
  id String @id @default(uuid())

  donationId String @unique

  receiptNumber String @unique
  issuedAt DateTime @default(now())

  donorName String
  donorEmail String?

  amount Decimal @db.Decimal(18, 2)
  currency String @default("IDR")

  campaignId String
  campaignTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)
  financeLedgers FinanceLedger[]
  @@index([campaignId])
  @@index([issuedAt])
  @@index([donorEmail])
}

model ReceiptSequence {
  year Int @id

  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt
}
// Qurban and Tabungan Qurban relations
/*
|--------------------------------------------------------------------------
| QURBAN PACKAGE
|--------------------------------------------------------------------------
*/

model QurbanPackage {
  id String @id @default(uuid())

  name        String
  slug        String @unique
  description String?

  animalType QurbanAnimalType

  /*
   * Number of shares represented by this package.
   *
   * GOAT/SHEEP normally = 1
   * COW can be 1 share or 7 shares depending on package.
   */
  shareCount Int @default(1)

  price    Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  qurbanYear Int

  distributionLocation String?

  quantityAvailable Int @default(0)
  quantitySold      Int @default(0)

  status QurbanPackageStatus @default(DRAFT)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  orders QurbanOrder[]

  @@index([animalType])
  @@index([qurbanYear])
  @@index([status])
  @@index([createdById])
}


/*
|--------------------------------------------------------------------------
| TABUNGAN QURBAN
|--------------------------------------------------------------------------
*/

model QurbanSavingPlan {
  id String @id @default(uuid())

  savingNumber String @unique

  donorId String

  qurbanAnimalType QurbanAnimalType

  /*
   * Target amount required to fulfill the selected Qurban package.
   */
  targetAmount Decimal @db.Decimal(18, 2)

  /*
   * Total successful contributions.
   */
  currentAmount Decimal @default(0) @db.Decimal(18, 2)

  /*
   * Remaining amount to reach the target.
   */
  remainingAmount Decimal @default(0) @db.Decimal(18, 2)

  currency String @default("IDR")

  contributionAmount Decimal? @db.Decimal(18, 2)

  frequency QurbanSavingFrequency

  startDate  DateTime
  targetDate DateTime

  status QurbanSavingStatus @default(ACTIVE)

  /*
   * Optional information about the selected destination.
   */
  distributionLocation String?

  /*
   * Optional pekurban name.
   */
  pekurbanName String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Restrict)

  contributions QurbanSavingContribution[]
  orders        QurbanOrder[]

  @@index([donorId])
  @@index([status])
  @@index([qurbanAnimalType])
  @@index([targetDate])
}


/*
|--------------------------------------------------------------------------
| TABUNGAN QURBAN CONTRIBUTION
|--------------------------------------------------------------------------
*/

model QurbanSavingContribution {
  id String @id @default(uuid())

  contributionNumber String @unique

  savingPlanId String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  status QurbanContributionStatus @default(PENDING)

  contributionDate DateTime @default(now())

  paymentReference String?
  paymentMethod    String?

  providerTransactionId String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savingPlan QurbanSavingPlan @relation(fields: [savingPlanId], references: [id], onDelete: Restrict)

  @@index([savingPlanId])
  @@index([status])
  @@index([contributionDate])
  @@index([providerTransactionId])
}


/*
|--------------------------------------------------------------------------
| QURBAN ORDER
|--------------------------------------------------------------------------
*/

model QurbanOrder {
  id String @id @default(uuid())

  orderNumber String @unique

  donorId String

  qurbanPackageId String

  /*
   * Optional link when the order comes from Tabungan Qurban.
   */
  savingPlanId String?

  animalType QurbanAnimalType

  /*
   * Number of Qurban units/orders.
   */
  quantity Int @default(1)

  /*
   * Number of shares represented by the order.
   */
  shareCount Int @default(1)

  unitPrice  Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  currency String @default("IDR")

  qurbanYear Int

  pekurbanName String

  donorName  String
  donorEmail String?
  donorPhone String?

  distributionLocation String?

  status QurbanOrderStatus @default(PENDING_PAYMENT)

  notes String?

  certificateNumber String?
  certificateUrl    String?

  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor         DonorProfile   @relation(fields: [donorId], references: [id], onDelete: Restrict)
  qurbanPackage QurbanPackage  @relation(fields: [qurbanPackageId], references: [id], onDelete: Restrict)
  savingPlan    QurbanSavingPlan? @relation(fields: [savingPlanId], references: [id], onDelete: SetNull)

  animals       QurbanAnimal[]
  documentations QurbanDocumentation[]
  distributions QurbanDistribution[]

  @@index([donorId])
  @@index([qurbanPackageId])
  @@index([savingPlanId])
  @@index([status])
  @@index([qurbanYear])
  @@index([createdAt])
}


/*
|--------------------------------------------------------------------------
| QURBAN ANIMAL
|--------------------------------------------------------------------------
*/

model QurbanAnimal {
  id String @id @default(uuid())

  animalCode String @unique

  qurbanOrderId String

  animalType QurbanAnimalType

  /*
   * Actual animal age in months.
   *
   * This allows the application to validate eligibility.
   */
  ageMonths Int?

  weightKg Decimal? @db.Decimal(10, 2)

  sex String?

  healthStatus String?

  location String?

  status QurbanAnimalStatus @default(REGISTERED)

  verifiedAt DateTime?
  slaughteredAt DateTime?
  processedAt DateTime?
  distributedAt DateTime?

  notes String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qurbanOrder QurbanOrder @relation(fields: [qurbanOrderId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  documentations QurbanDocumentation[]

  @@index([qurbanOrderId])
  @@index([animalType])
  @@index([status])
  @@index([createdById])
}


/*
|--------------------------------------------------------------------------
| QURBAN DOCUMENTATION
|--------------------------------------------------------------------------
*/

model QurbanDocumentation {
  id String @id @default(uuid())

  qurbanOrderId String

  /*
   * Optional because some documentation belongs specifically
   * to an animal.
   */
  qurbanAnimalId String?

  type QurbanDocumentationType

  fileUrl String

  title   String?
  caption String?

  takenAt DateTime?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qurbanOrder QurbanOrder @relation(fields: [qurbanOrderId], references: [id], onDelete: Cascade)

  qurbanAnimal QurbanAnimal? @relation(fields: [qurbanAnimalId], references: [id], onDelete: SetNull)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([qurbanOrderId])
  @@index([qurbanAnimalId])
  @@index([type])
  @@index([createdAt])
}


/*
|--------------------------------------------------------------------------
| QURBAN DISTRIBUTION
|--------------------------------------------------------------------------
*/

model QurbanDistribution {
  id String @id @default(uuid())

  distributionNumber String @unique

  qurbanOrderId String

  location String

  distributionDate DateTime?

  /*
   * Total meat packages prepared.
   */
  packageQuantity Int @default(0)

  /*
   * Number of beneficiaries receiving meat.
   */
  beneficiaryCount Int @default(0)

  status QurbanDistributionStatus @default(DRAFT)

  notes String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qurbanOrder QurbanOrder @relation(fields: [qurbanOrderId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  beneficiaries QurbanDistributionBeneficiary[]

  @@index([qurbanOrderId])
  @@index([status])
  @@index([distributionDate])
  @@index([location])
  @@index([createdById])
}


/*
|--------------------------------------------------------------------------
| QURBAN DISTRIBUTION BENEFICIARY
|--------------------------------------------------------------------------
*/

model QurbanDistributionBeneficiary {
  id String @id @default(uuid())

  distributionId String
  beneficiaryId String

  /*
   * Number of meat packages received.
   */
  packageQuantity Int @default(1)

  receivedAt DateTime?

  notes String?

  createdAt DateTime @default(now())

  distribution QurbanDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)

  @@unique([distributionId, beneficiaryId])
  @@index([distributionId])
  @@index([beneficiaryId])
}
