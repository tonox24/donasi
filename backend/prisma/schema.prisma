generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  FINANCE
  FUNDRAISING
  PROGRAM
  DONOR
  SELLER
  PARTNER
  STAFF
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

enum BeneficiaryType {
  INDIVIDUAL
  FAMILY
  COMMUNITY
  INSTITUTION
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String
  fullName     String
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  programs        Program[]
  campaigns       Campaign[]
  campaignUpdates CampaignUpdate[]
  beneficiaries   Beneficiary[]
  donorProfile    DonorProfile?

  @@index([email])
  @@index([phone])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  createdAt DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([code])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

/*
|--------------------------------------------------------------------------
| PROGRAM
|--------------------------------------------------------------------------
*/

model Program {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  status      ProgramStatus @default(ACTIVE)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  campaigns Campaign[]

  @@index([status])
  @@index([createdById])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN CATEGORY
|--------------------------------------------------------------------------
*/

model CampaignCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([isActive])
}

/*
|--------------------------------------------------------------------------
| BENEFICIARY
|--------------------------------------------------------------------------
*/

model Beneficiary {
  id          String          @id @default(uuid())
  name        String
  type        BeneficiaryType
  description String?
  location    String?
  isActive    Boolean         @default(true)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  campaigns CampaignBeneficiary[]

  @@index([type])
  @@index([isActive])
  @@index([createdById])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN
|--------------------------------------------------------------------------
*/

model Campaign {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  shortDescription String?
  description      String?

  targetAmount    Decimal @db.Decimal(18, 2)
  collectedAmount Decimal @default(0) @db.Decimal(18, 2)

  currency String @default("IDR")

  startDate DateTime?
  endDate   DateTime?

  status CampaignStatus @default(DRAFT)

  programId  String
  categoryId String
  createdById String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  program   Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  category  CampaignCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  images        CampaignImage[]
  updates       CampaignUpdate[]
  beneficiaries CampaignBeneficiary[]
  donations     Donation[]
  impacts       CampaignImpact[]

  @@index([status])
  @@index([programId])
  @@index([categoryId])
  @@index([createdById])
  @@index([startDate])
  @@index([endDate])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN IMAGE
|--------------------------------------------------------------------------
*/

model CampaignImage {
  id         String  @id @default(uuid())
  campaignId String

  imageUrl  String
  caption   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sortOrder])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN UPDATE
|--------------------------------------------------------------------------
*/

model CampaignUpdate {
  id         String @id @default(uuid())
  campaignId String
  createdById String

  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([createdById])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN BENEFICIARY
|--------------------------------------------------------------------------
*/

model CampaignBeneficiary {
  campaignId    String
  beneficiaryId String

  createdAt DateTime @default(now())

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@id([campaignId, beneficiaryId])
  @@index([beneficiaryId])
}

/*
|--------------------------------------------------------------------------
| DONOR PROFILE
|--------------------------------------------------------------------------
*/

model DonorProfile {
  id     String  @id @default(uuid())
  userId String? @unique

  fullName String
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String?

  isAnonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([email])
  @@index([phone])
}

/*
|--------------------------------------------------------------------------
| DONATION
|--------------------------------------------------------------------------
*/

model Donation {
  id         String  @id @default(uuid())
  donorId    String?
  campaignId String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  donorName  String
  donorEmail String?
  donorPhone String?
  message    String?

  isAnonymous Boolean        @default(false)
  status      DonationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt    DateTime?

  donorProfile DonorProfile? @relation(fields: [donorId], references: [id], onDelete: SetNull)
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  payments PaymentTransaction[]
  impacts  DonationImpact[]
  receipts Receipt[]

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([donorEmail])
  @@index([donorPhone])
}

/*
|--------------------------------------------------------------------------
| PAYMENT TRANSACTION
|--------------------------------------------------------------------------
*/

model PaymentTransaction {
  id         String @id @default(uuid())
  donationId String

  transactionReference String @unique
  provider             String
  paymentMethod        String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  status PaymentStatus @default(INITIATED)

  providerTransactionId String?
  paidAt                DateTime?
  expiredAt             DateTime?
  rawResponse           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([provider])
  @@index([status])
  @@index([providerTransactionId])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| CAMPAIGN IMPACT
|--------------------------------------------------------------------------
*/

model CampaignImpact {
  id         String @id @default(uuid())
  campaignId String

  name          String
  description   String?
  unit          String
  amountPerUnit Decimal @db.Decimal(18, 2)

  targetQuantity Decimal?
  displayOrder   Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donations DonationImpact[]

  @@index([campaignId])
  @@index([campaignId, isActive])
  @@index([displayOrder])
}

/*
|--------------------------------------------------------------------------
| DONATION IMPACT
|--------------------------------------------------------------------------
*/

model DonationImpact {
  id               String @id @default(uuid())
  donationId       String
  campaignImpactId String

  quantity        Decimal @db.Decimal(18, 2)
  amountAllocated Decimal @db.Decimal(18, 2)
  description     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation       Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaignImpact CampaignImpact @relation(fields: [campaignImpactId], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([campaignImpactId])
}
/* --------------------------------------------------------------------------
| RECEIPT / KUITANSI
|-------------------------------------------------------------------------- */

model Receipt {
  id         String @id @default(uuid())
  donationId String

  receiptNumber String   @unique
  issuedAt     DateTime @default(now())

  donorName  String
  donorEmail String?

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("IDR")

  campaignId String
  campaignTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@index([donationId])
  @@index([campaignId])
  @@index([issuedAt])
  @@index([donorEmail])
}

/* --------------------------------------------------------------------------
| RECEIPT NUMBER SEQUENCE
|-------------------------------------------------------------------------- */

model ReceiptSequence {
  year       Int @id
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt
}
